{
  "name": "next-site-template",
  "version": "0.0.0",
  "private": true,
  "description": "A statically exported Next.js site, with the house style and test suite the freeknet sites share.",
  "homepage": "https://github.com/freeknet/next-site-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/freeknet/next-site-template.git"
  },
  "bugs": {
    "url": "https://github.com/freeknet/next-site-template/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init:site": "node scripts/init.mjs",
    "assets": "node scripts/copy-font-licences.mjs && tsx scripts/render-icons.mts && tsx scripts/render-cards.mts",
    "cards:preview": "tsx scripts/preview-cards.mts",
    "cards:verify": "metaplate verify --require-content --format png --max-file-size 600000 --size 1200x630 \"out/**/og-image.png\"",
    "cards:baseline": "metaplate verify --baseline .og-baseline --update-baseline --size 1200x630 \"out/**/og-image.png\"",
    "cards:compare": "metaplate verify --baseline .og-baseline --write-diff .og-diff --size 1200x630 \"out/**/og-image.png\"",
    "cards:verify-live": "metaplate verify-page --target universal --target x --target linkedin --target whatsapp --target facebook",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "postbuild": "node scripts/flatten-rsc-segments.mjs && node scripts/build-sw.mjs && node scripts/csp-hashes.mjs && tsx scripts/audit-export.mts",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:links": "node scripts/check-links.mjs",
    "test:lighthouse": "lhci autorun",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run cards:verify && npm run test:links",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:preview": "node scripts/deploy-cloudflare.mjs --preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "github-slugger": "^2.0.0",
    "metaplate": "^0.8.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "linkinator": "^8.1.0",
    "satori": "^0.63.2",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
