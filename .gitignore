# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# env files
.env*
!.env.example

# hosts: local link state and build caches
.vercel
.netlify/
.wrangler/

# test output
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.lighthouseci/
/coverage/

# Playwright visual baselines are machine-specific; the specs assert behaviour, not pixels.
**/*-snapshots/

# Written before every dev and build (npm run assets).
/public/fonts/
/public/icons/
/public/og-image.png
/public/*/og-image.png
/.og-manifest.json

# Social card baselines and diffs (npm run cards:baseline / cards:compare): local review aids.
/.og-baseline/
/.og-diff/

# OS / editors
.DS_Store
*.pem
npm-debug.log*
